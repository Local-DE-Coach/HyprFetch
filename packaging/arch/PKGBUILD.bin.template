# Maintainer: HyprFetch Contributors <Local-DE-Coach@users.noreply.github.com>
# Fast-install binary package for Arch Linux (generated for each release;
# pkgver and sha256sums are pinned to that release by CI).
#
# Usage (build in a scratch dir so makepkg's src/, pkg/ and *.pkg.tar.zst
# never litter your current folder — e.g. your Desktop):
#     d=$(mktemp -d); cd $d \
#       && curl -fLO https://istias.tech/hyprfetch/updates/<version>/PKGBUILD \
#       && makepkg -si; cd - >/dev/null; rm -rf $d
#
# The source tarball comes from the istias.tech update channel — the same
# sha256-verified mirror the CLI updater uses. No GitHub involved.
# Remove again with:  sudo pacman -Rns hyprfetch-bin
#
# Installs the standard Linux layout: /usr/bin/hyprfetch, docs in
# /usr/share/doc, desktop entry + icon so "HyprFetch" shows up in app
# launchers like any other installed application.
pkgname=hyprfetch-bin
pkgver=__VERSION__
pkgrel=1
pkgdesc="Minimal-RAM, fast, resumable download manager with a web UI (prebuilt binary)"
arch=('x86_64')
url="https://istias.tech/hyprfetch"
license=('MIT')
depends=('glibc' 'gcc-libs')
optdepends=('xdg-utils: open the web UI / download folder from the daemon')
provides=('hyprfetch')
conflicts=('hyprfetch')
source=("hyprfetch-${pkgver}.tar.gz::https://istias.tech/hyprfetch/updates/${pkgver}/hyprfetch-${pkgver}-linux-x64.tar.gz")
sha256sums=('__SHA256__')

package() {
    # CI renames the archive root to the clean "hyprfetch-<ver>-linux-x64"
    # directory (same name as the tarball, minus the extension).
    local _srcdir="${srcdir}/hyprfetch-${pkgver}-linux-x64"
    install -Dm755 "${_srcdir}/hyprfetch"   "${pkgdir}/usr/bin/hyprfetch"
    install -Dm644 "${_srcdir}/README.md"   "${pkgdir}/usr/share/doc/hyprfetch/README.md"
    install -Dm644 "${_srcdir}/CHANGELOG.md" "${pkgdir}/usr/share/doc/hyprfetch/CHANGELOG.md"
    install -Dm644 "${_srcdir}/LICENSE"     "${pkgdir}/usr/share/licenses/hyprfetch-bin/LICENSE"
    # Desktop entry + icon at the standard Linux paths so "HyprFetch" shows
    # up in desktop menus / app launchers like any other application.
    install -Dm644 "${_srcdir}/hyprfetch.desktop" "${pkgdir}/usr/share/applications/hyprfetch.desktop"
    install -Dm644 "${_srcdir}/hyprfetch.svg"     "${pkgdir}/usr/share/icons/hicolor/scalable/apps/hyprfetch.svg"
}

