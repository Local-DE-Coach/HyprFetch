{
  "manifest_version": 3,
  "name": "HyprFetch Media Catcher",
  "version": "0.6.3",
  "description": "Catch videos, audio, images and big files on any page and send them to the HyprFetch download manager — IDM-style buttons on videos, real quality lists (8K→480p), local-only.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "downloads",
    "contextMenus"
  ],
  "host_permissions": [
    "http://127.0.0.1:7780/*",
    "http://localhost:7780/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "HyprFetch Media Catcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
