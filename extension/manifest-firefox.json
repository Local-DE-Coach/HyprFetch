{
  "manifest_version": 3,
  "name": "HyprFetch Media Catcher",
  "version": "0.6.2",
  "description": "Catch videos, audio, images and big files on any page and send them to the HyprFetch download manager \u2014 IDM-style, local-only.",
  "permissions": [
    "tabs",
    "storage",
    "webRequest",
    "downloads"
  ],
  "host_permissions": [
    "http://127.0.0.1:7780/*",
    "http://localhost:7780/*",
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "hyprfetch@istias.tech",
      "strict_min_version": "121.0"
    }
  },
  "action": {
    "default_title": "HyprFetch Media Catcher",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
